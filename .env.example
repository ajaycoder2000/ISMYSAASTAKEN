# ==========================================
# IsMySaaSTaken Environment Variables Checklist
# ==========================================

# 1. AI Engine (Required for Idea Scans & Web Search Grounding)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Database & Auth (Required for User Sync, Scans, & Subscribers)
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Weekly Gap Report Email System (Required for Resend & Vercel Cron)
RESEND_API_KEY=re_your_resend_api_key_here
CRON_SECRET=generate_a_random_32_char_string_here
# Optional: Defaults to 'IsMySaaSTaken <onboarding@resend.dev>' until your domain is verified on Resend
# RESEND_FROM_EMAIL=IsMySaaSTaken <gaps@ismysaastaken.com>

# 4. Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# 5. Site & Admin Configuration
ADMIN_EMAIL=ismysaastaken@gmail.com
NEXT_PUBLIC_SITE_URL=https://ismysaastaken.vercel.app

# 6. Stripe Billing (Optional - For Sprint Passes & Founder Pro)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 7. Dodo Payments (Primary Payment Gateway)
# Set DODO_PAYMENTS_ENVIRONMENT to 'live_mode' or 'test_mode'
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_RETURN_URL=https://ismysaastaken.vercel.app/checkout/success

